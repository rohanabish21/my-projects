    <style>
        body {
            background-color: #05070e;
            color: #e2e8f0;
            font-family: 'Lato', sans-serif;
            overflow-x: hidden;
            user-select: none;
        }

        /* Gold metallic text glow */
        .gold-glow {
            text-shadow: 0 0 15px rgba(251, 191, 36, 0.4), 0 0 30px rgba(245, 158, 11, 0.2);
        }

        /* Ambient temple canvas background */
        #particleCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            pointer-events: none;
            z-index: 0;
        }

        /* Stone Lock Key Slot Glow */
        .lock-slot {
            background: radial-gradient(circle, rgba(30, 41, 59, 1) 0%, rgba(15, 23, 42, 1) 100%);
            box-shadow: inset 0 4px 10px rgba(0, 0, 0, 0.8), 0 0 15px rgba(245, 158, 11, 0.1);
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* Dynamic Dial Spin Animation */
        .dial-spin-up {
            transform: translateY(-4px) scale(1.05);
        }

        .dial-spin-down {
            transform: translateY(4px) scale(1.05);
        }

        /* Interactive Tag Highlight */
        .word-tag {
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .word-tag:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        }

        /* Shimmer effect for buttons */
        .btn-shimmer {
            background: linear-gradient(135deg, #d97706 0%, #fbbf24 50%, #b45309 100%);
            background-size: 200% auto;
            transition: all 0.3s ease;
        }

        .btn-shimmer:hover {
            background-position: right center;
            box-shadow: 0 0 20px rgba(251, 191, 36, 0.5);
            transform: scale(1.02);
        }

        /* Sliding Drawer for Codex */
        .codex-drawer {
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #0f172a;
        }

        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #f59e0b;
        }

        /* Pulse animation for active clues */
        @keyframes subtlePulse {

            0%,
            100% {
                border-color: rgba(245, 158, 11, 0.4);
                box-shadow: 0 0 10px rgba(245, 158, 11, 0.1);
            }

            50% {
                border-color: rgba(245, 158, 11, 0.9);
                box-shadow: 0 0 25px rgba(245, 158, 11, 0.3);
            }
        }

        .active-pulse {
            animation: subtlePulse 2s infinite;
        }

        /* Red Alarm Pulse for Wrong Answer */
        @keyframes redAlertPulse {
            0% {
                background-color: rgba(239, 68, 68, 0.35);
                box-shadow: 0 0 40px rgba(239, 68, 68, 0.6);
            }

            50% {
                background-color: rgba(239, 68, 68, 0.15);
                box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
            }

            100% {
                background-color: rgba(15, 23, 42, 0.9);
            }
        }

        .animate-red-alert {
            animation: redAlertPulse 0.8s ease-in-out;
        }

        @keyframes heavyShake {

            0%,
            100% {
                transform: translateX(0);
            }

            15%,
            45%,
            75% {
                transform: translateX(-10px) rotate(-1deg);
            }

            30%,
            60%,
            90% {
                transform: translateX(10px) rotate(1deg);
            }
        }

        .animate-shake {
            animation: heavyShake 0.5s ease-in-out;
        }

        /* Continuous Golden Pulse for Victory Screen */
        @keyframes divineGlow {

            0%,
            100% {
                transform: scale(1);
                filter: drop-shadow(0 0 15px rgba(251, 191, 36, 0.4));
            }

            50% {
                transform: scale(1.08);
                filter: drop-shadow(0 0 35px rgba(251, 191, 36, 0.8));
            }
        }

        .divine-pulse {
            animation: divineGlow 3s ease-in-out infinite;
        }
    </style>
