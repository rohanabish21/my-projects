                                            </span>

                                            <button onclick="spinDial(${idx}, -1)" class="w-full text-slate-400 hover:text-amber-400 py-0.5 transition text-xs">
                                                <i class="fa-solid fa-chevron-down"></i>
                                            </button>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>

                            <div class="w-full max-w-xs flex items-center justify-between mt-5 text-[10px] font-mono text-amber-400/80 border-t border-slate-800/80 pt-2.5">
                                <span>High Digits</span>
                                <span class="flex items-center font-bold text-amber-300">
                                    <i class="fa-solid fa-arrow-left mr-1"></i> Order (Right to Left)
                                </span>
                                <span>Units</span>
                            </div>

                            <button onclick="checkSolution()" class="btn-shimmer mt-5 w-full max-w-xs py-3 rounded-xl font-cinzel font-bold text-slate-950 text-xs md:text-sm tracking-wider uppercase shadow-lg flex items-center justify-center space-x-2">
                                <i class="fa-solid fa-key"></i>
                                <span>Trigger Gear Mechanism</span>
                            </button>

                        </div>
                    </div>

                </div>

                <div id="hintModal" class="hidden absolute inset-0 bg-slate-950/90 backdrop-blur-md z-30 p-8 flex flex-col items-center justify-center text-center">
                    <div class="max-w-md bg-slate-900 border border-amber-500/40 p-6 rounded-2xl shadow-2xl space-y-4">
                        <i class="fa-solid fa-lightbulb text-amber-400 text-3xl"></i>
                        <h3 class="font-cinzel text-lg font-bold text-amber-300">Cryptographer's Hint</h3>
                        <p class="text-sm text-slate-300 leading-relaxed">${stage.hint}</p>
                        <button onclick="toggleHint()" class="px-5 py-2 bg-amber-500 text-slate-950 rounded-lg font-bold text-xs uppercase tracking-wider">
                            Got It
                        </button>
                    </div>
                </div>

                <div id="successOverlay" class="hidden absolute inset-0 bg-slate-950/95 backdrop-blur-xl z-30 p-8 flex flex-col items-center justify-center text-center space-y-6">
                    <div class="w-20 h-20 rounded-full bg-amber-500/20 border-2 border-amber-400 flex items-center justify-center text-amber-400 text-4xl shadow-2xl gold-glow animate-bounce">
                        <i class="fa-solid fa-unlock-keyhole"></i>
                    </div>
                    <div class="space-y-2">
                        <span class="text-xs font-mono text-amber-400 uppercase tracking-widest">Vault Unlocked!</span>
                        <h3 class="font-cinzel text-3xl font-bold text-amber-300">${stage.title} Cleared</h3>
                        <p class="text-sm text-slate-300 max-w-lg mx-auto">
                            The heavy stone mechanism shifts with a resonant click, revealing lost mathematical scriptures!
                        </p>
                    </div>
                    <button onclick="proceedAfterSuccess()" class="btn-shimmer px-8 py-3 rounded-xl font-cinzel font-bold text-slate-950 text-sm tracking-wider uppercase shadow-xl flex items-center space-x-2">
                        <span>Continue to Next Vault</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            `;
        }

        // ==========================================
        // 5. INTERACTIVE ACTIONS & GAME LOGIC
        // ==========================================
        function getPositionLabel(idx, total) {
            const labelsFromRight = ["Units", "Tens", "Hundreds", "Thousands", "10-Thousands"];
            const posFromRight = total - 1 - idx;
            return labelsFromRight[posFromRight] || `10^${posFromRight}`;
        }

        function spinDial(idx, dir) {
            playSound('dial');
            currentDials[idx] = (currentDials[idx] + dir + 10) % 10;

            const dialElement = document.getElementById(`dialVal_${idx}`);
            const slotElement = document.getElementById(`lockSlot_${idx}`);

            dialElement.innerText = currentDials[idx];

            slotElement.classList.add(dir > 0 ? 'dial-spin-up' : 'dial-spin-down');
            setTimeout(() => {
                slotElement.classList.remove('dial-spin-up', 'dial-spin-down');
            }, 150);
        }

        function inspectWord(wordIdx) {
            playSound('word');
            const stage = GAME_LEVELS[currentLevelIdx];
            const item = stage.shlokaWords[wordIdx];
            const inspector = document.getElementById('inspectorBox');

            inspector.innerHTML = `
                <div class="flex items-center space-x-3 text-left w-full">
                    <div class="w-9 h-9 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-300 font-cinzel font-bold text-base flex-shrink-0">
                        ${item.value}
                    </div>
                    <div>
                        <div class="text-xs font-bold text-amber-300">${item.text} = ${item.entity} (${item.value})</div>
                        <div class="text-[11px] text-slate-400">${item.desc}</div>
                    </div>
                </div>
            `;
        }

        function toggleHint() {
            playSound('word');
            const hintModal = document.getElementById('hintModal');
            hintModal.classList.toggle('hidden');
        }

        function checkSolution() {
            const stage = GAME_LEVELS[currentLevelIdx];
            const isCorrect = currentDials.every((val, i) => val === stage.solution[i]);

            if (isCorrect) {
                playSound('success');
                activeExplosion = true;

                // If it's the final chamber (Level 20), trigger grand celebration immediately
                if (currentLevelIdx === GAME_LEVELS.length - 1) {
                    setTimeout(() => {
                        renderGrandFinale();
                    }, 800);
                } else {
                    document.getElementById('successOverlay').classList.remove('hidden');
                }

                setTimeout(() => { activeExplosion = false; }, 3000);
            } else {
                playSound('error');

                const redOverlay = document.getElementById('redFlashOverlay');
                const lockBox = document.getElementById('lockMechanismBox');
                const stageContainer = document.getElementById('gameSlideStage');

                redOverlay.style.opacity = '1';
                lockBox.classList.add('animate-shake', 'animate-red-alert');
                stageContainer.classList.add('border-red-500/60');

                setTimeout(() => {
                    redOverlay.style.opacity = '0';
                    lockBox.classList.remove('animate-shake', 'animate-red-alert');
                    stageContainer.classList.remove('border-red-500/60');
                }, 600);

                const inspector = document.getElementById('inspectorBox');
                inspector.innerHTML = `
                    <span class="text-red-400 font-semibold text-xs">
                        <i class="fa-solid fa-triangle-exclamation mr-1"></i> Combination incorrect! Remember: Place the 1st word's value in the Units place (far right).
                    </span>
                `;
            }
        }

        function proceedAfterSuccess() {
            playSound('click');
            if (currentLevelIdx < GAME_LEVELS.length - 1) {
                currentLevelIdx++;
                renderStage();
            } else {
                renderGrandFinale();
            }
        }

        function prevLevel() {
            if (currentLevelIdx > 0) {
                playSound('click');
                currentLevelIdx--;
                renderStage();
            }
        }

        function nextLevel() {
            if (currentLevelIdx < GAME_LEVELS.length - 1) {
                playSound('click');
                currentLevelIdx++;
                renderStage();
            }
        }

        function renderProgressDots() {
            const container = document.getElementById('levelProgressContainer');
            container.innerHTML = GAME_LEVELS.map((lvl, i) => `
                <button onclick="jumpToLevel(${i})" class="w-6 h-6 rounded-full text-[10px] font-bold transition flex-shrink-0 flex items-center justify-center ${i === currentLevelIdx
                    ? 'bg-amber-500 text-slate-950 font-bold shadow-md'
                    : 'bg-slate-800 text-slate-400 hover:bg-slate-700'
                }">
                    ${i + 1}
                </button>
            `).join('');

            const activeDot = container.children[currentLevelIdx];
            if (activeDot) {
                activeDot.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }
        }

        function jumpToLevel(idx) {
            playSound('click');
            currentLevelIdx = idx;
            renderStage();
        }

        // ==========================================
        // 6. GRAND FINALE VICTORY CELEBRATION
        // ==========================================
        function renderGrandFinale() {
            playSound('grand_fanfare');

            // Auto-start peaceful music drone for celebration ambience if off
            if (!isBGMOn) {
                toggleBGM();
            }

            // Launch Canvas Golden Confetti Celebration
            if (typeof confetti === 'function') {
                const duration = 3.5 * 1000;
                const end = Date.now() + duration;

                (function frame() {
                    confetti({
                        particleCount: 5,
                        angle: 60,
                        spread: 55,
                        origin: { x: 0 },
                        colors: ['#fbbf24', '#f59e0b', '#d97706', '#ffffff']
                    });
                    confetti({
                        particleCount: 5,
                        angle: 120,
                        spread: 55,
                        origin: { x: 1 },
                        colors: ['#fbbf24', '#f59e0b', '#d97706', '#ffffff']
                    });

                    if (Date.now() < end) {
                        requestAnimationFrame(frame);
                    }
                })();
            }

            const container = document.getElementById('gameSlideStage');
            container.innerHTML = `
                <div class="p-8 md:p-12 text-center flex flex-col items-center justify-center min-h-[580px] space-y-6 relative overflow-hidden bg-gradient-to-b from-slate-950 via-amber-950/20 to-slate-950">
                    
                    <div class="w-28 h-28 rounded-full bg-amber-500/20 border-2 border-amber-400 flex items-center justify-center text-amber-400 text-6xl shadow-2xl divine-pulse">
                        𑁍
                    </div>

                    <div class="space-y-3 max-w-2xl">
                        <div class="inline-block px-4 py-1 rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-300 font-mono text-xs font-bold uppercase tracking-widest mb-2">
                            🏆 Vault 20 Cleared - Cryptographer Grandmaster
                        </div>
                        <h2 class="font-cinzel text-3xl md:text-5xl font-extrabold text-amber-300 gold-glow">
                            CHAMBER CLEARED!
                        </h2>
                        <h3 class="font-cinzel text-lg md:text-xl text-amber-400/90 tracking-wide font-semibold">
                            All 20 Ancient Bhūtasaṃkhyā Cryptograms Deciphered
                        </h3>
                        <p class="text-slate-300 text-xs md:text-sm leading-relaxed max-w-xl mx-auto pt-2">
                            You have unlocked the Apex Sanctorum! By mastering <strong>Aṅkānāṁ Vāmato Gatih</strong> (Right-to-Left digit flow), you have restored the ancient mathematical wisdom of Kerala and Ujjain.
                        </p>
                    </div>

                    <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
                        <button onclick="jumpToLevel(0)" class="btn-shimmer px-8 py-3.5 rounded-xl font-cinzel font-bold text-slate-950 text-xs md:text-sm tracking-wider uppercase shadow-2xl flex items-center space-x-2">
                            <i class="fa-solid fa-rotate-right mr-2"></i>
                            <span>Replay Cryptogram Deck</span>
                        </button>
                    </div>

                </div>
            `;
        }

        // ==========================================
        // 7. CODEX DRAWER LOGIC
        // ==========================================
        function populateCodex() {
            const list = document.getElementById('codexList');
            list.innerHTML = CODEX_DATA.map(item => `
                <div class="bg-slate-900 border border-slate-800 rounded-xl p-4 flex items-start space-x-4 hover:border-amber-500/40 transition">
                    <div class="w-10 h-10 rounded-lg bg-amber-500/10 border border-amber-500/30 flex-shrink-0 flex items-center justify-center">
                        <span class="font-cinzel text-base font-bold text-amber-400">${item.digit}</span>
                    </div>
                    <div>
                        <h4 class="font-cinzel font-bold text-amber-300 text-xs">${item.title}</h4>
                        <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block my-0.5">${item.entity}</span>
                        <p class="text-xs text-slate-400 mt-1 leading-relaxed">${item.desc}</p>
                    </div>
                </div>
            `).join('');
        }

        function openCodex() {
            playSound('word');
            document.getElementById('codexDrawer').classList.remove('translate-x-full');
            document.getElementById('codexOverlay').classList.remove('hidden');
        }

        function closeCodex() {
            playSound('click');
            document.getElementById('codexDrawer').classList.add('translate-x-full');
            document.getElementById('codexOverlay').classList.add('hidden');
        }

        // ==========================================
        // 8. DYNAMIC PARTICLES & EXPLOSION ENGINE
        // ==========================================
        function initCanvasParticles() {
            const canvas = document.getElementById('particleCanvas');
            const ctx = canvas.getContext('2d');
            let width = canvas.width = window.innerWidth;
            let height = canvas.height = window.innerHeight;

            window.addEventListener('resize', () => {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            });

            const particles = Array.from({ length: 50 }, () => ({
                x: Math.random() * width,
                y: Math.random() * height,
                radius: Math.random() * 2 + 0.5,
                alpha: Math.random() * 0.5 + 0.1,
                speedY: -(Math.random() * 0.3 + 0.1),
                speedX: (Math.random() - 0.5) * 0.2
            }));

            function animate() {
                ctx.clearRect(0, 0, width, height);

                particles.forEach(p => {
                    p.y += p.speedY;
                    p.x += p.speedX;

                    if (activeExplosion) {
                        p.radius = Math.random() * 4 + 1;
                        p.alpha = Math.random() * 0.9 + 0.1;
                    } else if (p.radius > 2.5) {
                        p.radius = Math.random() * 2 + 0.5;
                    }

                    if (p.y < 0) p.y = height;
                    if (p.x < 0 || p.x > width) p.x = Math.random() * width;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = activeExplosion ? `rgba(251, 191, 36, ${p.alpha})` : `rgba(245, 158, 11, ${p.alpha})`;
                    ctx.fill();
                });

                requestAnimationFrame(animate);
            }
            animate();
        }

        // Initialize Application
        window.addEventListener('DOMContentLoaded', () => {
            populateCodex();
            renderStage();
            initCanvasParticles();
        });
    </script>
</body>

